\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Layer-wise timings, GFLOPS, and memory bandwidth for GPU implementation across all 10,000 MNIST test samples. FC layers achieve exceptionally high GFLOPS (7,840 for FC1) due to high arithmetic intensity and batch processing. Spatial layers achieve moderate performance with memory coalescing. Total processing time demonstrates strong GPU utilization.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:timings}{{1}{4}{Layer-wise timings, GFLOPS, and memory bandwidth for GPU implementation across all 10,000 MNIST test samples. FC layers achieve exceptionally high GFLOPS (7,840 for FC1) due to high arithmetic intensity and batch processing. Spatial layers achieve moderate performance with memory coalescing. Total processing time demonstrates strong GPU utilization}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Speedup comparison between implementations on single MNIST sample (measured on complete 10,000 test samples). CPU measurements conducted on same hardware with ConvolutionLayerCPU implementation. PyTorch uses highly optimized cuDNN kernels and achieves 4,900x speedup over CPU with 0.0059 ms per sample. Our GPU implementation achieves 2,473x acceleration, reaching approximately 50\% of PyTorch's performance without specialized libraries.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:comparison}{{2}{4}{Speedup comparison between implementations on single MNIST sample (measured on complete 10,000 test samples). CPU measurements conducted on same hardware with ConvolutionLayerCPU implementation. PyTorch uses highly optimized cuDNN kernels and achieves 4,900x speedup over CPU with 0.0059 ms per sample. Our GPU implementation achieves 2,473x acceleration, reaching approximately 50\% of PyTorch's performance without specialized libraries}{table.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Conclusion}{4}{section.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Cumulative improvement from shared memory optimizations on full 10,000-sample dataset. Convolution input tiling reduces global memory traffic for kernel weights and input pixels by caching tiles in shared memory, yielding 18\% improvement (30.3 ms saved). FC input row caching further reduces global memory bandwidth by keeping input rows in shared memory across output feature computations, yielding 16\% additional improvement (22.3 ms saved). Combined, optimizations provide 45\% total speedup, reducing inference time from 169.4 ms to 116.8 ms.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:optimization}{{3}{5}{Cumulative improvement from shared memory optimizations on full 10,000-sample dataset. Convolution input tiling reduces global memory traffic for kernel weights and input pixels by caching tiles in shared memory, yielding 18\% improvement (30.3 ms saved). FC input row caching further reduces global memory bandwidth by keeping input rows in shared memory across output feature computations, yielding 16\% additional improvement (22.3 ms saved). Combined, optimizations provide 45\% total speedup, reducing inference time from 169.4 ms to 116.8 ms}{table.3}{}}
