\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Layer-wise timings, GFLOPS, and memory bandwidth for GPU implementation. FC layers achieve high GFLOPS due to high arithmetic intensity, while spatial layers (Conv, Pool) achieve lower GFLOPS but benefit from memory coalescing. The total average reflects weighted contribution across layers.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:timings}{{1}{4}{Layer-wise timings, GFLOPS, and memory bandwidth for GPU implementation. FC layers achieve high GFLOPS due to high arithmetic intensity, while spatial layers (Conv, Pool) achieve lower GFLOPS but benefit from memory coalescing. The total average reflects weighted contribution across layers}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Speedup comparison between implementations on single MNIST sample. CPU measurements conducted on same hardware with ConvolutionLayerCPU implementation and optimizations enabled. PyTorch uses specialized cuDNN kernels and kernel fusion, achieving additional speedup. Our GPU implementation achieves 57.5x acceleration without specialized libraries, demonstrating effectiveness of data-parallel CUDA kernel design.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:comparison}{{2}{4}{Speedup comparison between implementations on single MNIST sample. CPU measurements conducted on same hardware with ConvolutionLayerCPU implementation and optimizations enabled. PyTorch uses specialized cuDNN kernels and kernel fusion, achieving additional speedup. Our GPU implementation achieves 57.5x acceleration without specialized libraries, demonstrating effectiveness of data-parallel CUDA kernel design}{table.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Conclusion}{4}{section.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Cumulative improvement from shared memory optimizations. Convolution input tiling reduces global memory traffic for kernel weights and input pixels by caching tiles in shared memory, yielding 18\% improvement. FC input row caching further reduces global memory bandwidth by keeping input rows in shared memory across output feature computations, yielding 16\% additional improvement over the tiled version. Combined, optimizations provide 45\% total speedup.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:optimization}{{3}{5}{Cumulative improvement from shared memory optimizations. Convolution input tiling reduces global memory traffic for kernel weights and input pixels by caching tiles in shared memory, yielding 18\% improvement. FC input row caching further reduces global memory bandwidth by keeping input rows in shared memory across output feature computations, yielding 16\% additional improvement over the tiled version. Combined, optimizations provide 45\% total speedup}{table.3}{}}
